---
import { SITE } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-content">
    <div class="footer-brand">
      <svg class="nav-mark" viewBox="0 0 128 128" aria-hidden="true">
        <rect width="128" height="128" rx="28" fill="#4ade80"></rect>
        <path d="M38 92 L64 66 L64 36" fill="none" stroke="#07130c" stroke-width="9" stroke-linecap="round" stroke-linejoin="round"></path>
        <circle cx="38" cy="92" r="11" fill="#07130c"></circle>
        <circle cx="64" cy="66" r="7.5" fill="#ffffff"></circle>
        <circle cx="64" cy="36" r="6" fill="#86efac"></circle>
      </svg>
      <div class="footer-brand-text">
        <h3>CHALLENGE JAR<em>_26</em></h3>
        <p>{SITE.org} · {SITE.orgSubtitle}</p>
      </div>
    </div>
    <div class="footer-contact">
      <p>Ecosistema</p>
      <a href={SITE.simRepo} target="_blank" rel="noopener">Simulador · yahboom_rosmaster</a>
      <a href={SITE.workshopsRepo} target="_blank" rel="noopener">Workshops · jar_workshops</a>
      <a href={SITE.orgUrl} target="_blank" rel="noopener">{SITE.orgUrl.replace('https://', '')}</a>
    </div>
  </div>
  <div class="footer-bottom">
    <span>© {year} {SITE.org} · Jornadas Argentinas de Robótica</span>
    <span>Ubuntu 22.04 · ROS 2 Humble · Gazebo Fortress</span>
  </div>
</footer>
