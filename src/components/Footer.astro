---
import RobotMark from './RobotMark.astro';
import { SITE } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-content">
    <div class="footer-brand">
      <RobotMark class="footer-mark" />
      <div class="footer-brand-text">
        <p class="footer-kicker">Challenge JAR 2026</p>
        <p>{SITE.org} · {SITE.orgSubtitle}</p>
      </div>
    </div>

    <nav class="footer-links" aria-label="Ecosistema Challenge JAR">
      <a href={SITE.simRepo} target="_blank" rel="noopener">Simulador</a>
      <a href={SITE.workshopsRepo} target="_blank" rel="noopener">Workshops</a>
      <a href={SITE.orgUrl} target="_blank" rel="noopener">AIR Club UdeSA</a>
      <a href={SITE.githubOrg} target="_blank" rel="noopener">GitHub</a>
    </nav>
  </div>

  <div class="footer-bottom">
    <span>© {year} {SITE.org} · Jornadas Argentinas de Robótica</span>
    <span>{SITE.event.city} · {SITE.event.dateRange}</span>
  </div>
</footer>
