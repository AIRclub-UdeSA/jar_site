---
import { getCollection } from 'astro:content';
import { DOC_SECTIONS, withBase } from '../config/site';

const allDocs = await getCollection('docs');
const weeks = allDocs
  .filter((d) => d.id.startsWith('workshops/semana-'))
  .sort((a, b) => a.id.localeCompare(b.id));

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';

// Coincidencia exacta: cada página del sidebar tiene su propia entrada, así que
// un prefijo dejaría el índice de la sección marcado también en sus subpáginas.
const isActive = (href: string): boolean => {
  const target = withBase(href).replace(/\/+$/, '') || '/';
  return path === target;
};
---

{
  DOC_SECTIONS.map((section) => (
    <div class="side-group">
      <p class="side-label">// {section.label}</p>
      {section.items.map((item) => (
        <a class:list={['side-link', { active: isActive(item.href) }]} href={withBase(item.href)}>
          <span>{item.label}</span>
        </a>
      ))}
    </div>
  ))
}
<div class="side-group">
  <p class="side-label">// Workshops</p>
  <a class:list={['side-link', { active: isActive('/workshops/') }]} href={withBase('/workshops/')}>
    <span>Sobre los workshops</span>
  </a>
  {
    weeks.map((week) => (
      <a
        class:list={['side-link', { active: isActive(`/${week.id}/`) }]}
        href={withBase(`/${week.id}/`)}
      >
        <span>{week.data.title}</span>
        {week.data.status === 'proximamente' && <span class="soon-dot" title="Próximamente" />}
      </a>
    ))
  }
</div>
