---
import DonatelloProfile from './DonatelloProfile.astro';
import { SITE, withBase } from '../../config/site';
---

<div class="landing-donatello-story">
  <section class="landing-hero" aria-labelledby="landing-hero-title">
    <div class="landing-shell">
      <div class="landing-hero-copy">
        <p class="landing-meta landing-hero-meta">
          Challenge JAR 2026 · {SITE.event.city} · {SITE.event.shortDate}
        </p>
        <h1 id="landing-hero-title" class="landing-hero-title">
          Un robot.<br />
          Una tarea.<br />
          Tu código.
        </h1>
        <p class="landing-hero-lede">
          El desafío arranca en tu compu: vos y tu equipo desarrollan el comportamiento
          del robot y lo prueban en el simulador. Pueden iterar, ajustar y volver a intentar.
          Todo ese trabajo se pone a prueba cuando llegue la JAR 2026.
        </p>
        <div class="landing-actions">
          <a class="landing-action landing-action-primary" href={SITE.applyUrl} target="_blank" rel="noopener">
            Postular equipo
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
          </a>
          <a class="landing-action landing-action-secondary" href={withBase('/setup/')}>
            Preparar el entorno
          </a>
        </div>
      </div>
    </div>
  </section>

  <div class="landing-story-visual">
    <figure class="landing-viewer">
      <div
        id="robot-stage"
        class="landing-viewer-stage"
        role="img"
        aria-label="Modelo 3D interactivo de Donatello, el robot ROSMASTER X3"
        aria-describedby="robot-instructions"
      >
        <p class="landing-viewer-status" role="status" aria-live="polite">Cargando modelo 3D…</p>
      </div>
      <div class="landing-viewer-control" data-robot-controls aria-hidden="true"></div>
      <figcaption id="robot-instructions" class="landing-viewer-caption">
        <span class="landing-viewer-caption-pointer">Arrastrá para girar · mantené click y usá la rueda para acercar</span>
        <span class="landing-viewer-caption-touch">Deslizá horizontalmente para girar</span>
      </figcaption>
    </figure>
  </div>

  <DonatelloProfile />
</div>

<script>
  const stage = document.getElementById('robot-stage');
  const story = stage?.closest<HTMLElement>('.landing-donatello-story') ?? null;
  const status = stage?.querySelector<HTMLElement>('.landing-viewer-status') ?? null;
  const controlSurface = story?.querySelector<HTMLElement>('[data-robot-controls]') ?? null;
  // Las custom properties se escriben en cada frame de scroll. Setearlas en <figure>
  // y no en .landing-donatello-story limita el recálculo de estilos a los tres hijos
  // del visor, en vez de invalidar todo el subárbol de la sección (hero + perfil).
  const viewer = stage?.closest<HTMLElement>('.landing-viewer') ?? null;

  const reportError = (message: string) => {
    if (!status) return;
    status.classList.add('is-error');
    status.textContent = `No pudimos cargar el modelo 3D: ${message}`;
  };

  if (stage && status && controlSurface) {
    const controlsElement = controlSurface;
    const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const coarsePointer = window.matchMedia('(pointer: coarse)').matches;
    let started = false;

    const lazyLoad = new IntersectionObserver(
      (entries) => {
        if (!started && entries.some((entry) => entry.isIntersecting)) {
          started = true;
          lazyLoad.disconnect();
          initViewer().catch((error) => {
            reportError(error instanceof Error ? error.message : String(error));
          });
        }
      },
      { rootMargin: '160px' }
    );

    lazyLoad.observe(stage);

    async function initViewer() {
      if (!stage || !status) return;

      const [THREE, { OrbitControls }, { GLTFLoader }] = await Promise.all([
        import('three'),
        import('three/addons/controls/OrbitControls.js'),
        import('three/addons/loaders/GLTFLoader.js'),
      ]);

      const renderer = new THREE.WebGLRenderer({ antialias: !coarsePointer, alpha: true });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, coarsePointer ? 1.25 : 1.75));
      renderer.outputColorSpace = THREE.SRGBColorSpace;
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.25;
      renderer.domElement.setAttribute('aria-hidden', 'true');
      stage.prepend(renderer.domElement);

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(34, 1, 0.05, 50);
      camera.position.set(1.75, 1.05, 2.25);
      const robotRig = new THREE.Group();
      scene.add(robotRig);

      scene.add(new THREE.HemisphereLight(0xffffff, 0x14281c, 2.6));

      const key = new THREE.DirectionalLight(0xffffff, 3.4);
      key.position.set(2.5, 4.5, 3.5);
      scene.add(key);

      const fill = new THREE.DirectionalLight(0x4ade80, 1.8);
      fill.position.set(-3.5, 2.5, 2.5);
      scene.add(fill);

      const backLight = new THREE.DirectionalLight(0x86efac, 1.4);
      backLight.position.set(0, 3.5, -4);
      scene.add(backLight);

      const rim = new THREE.DirectionalLight(0xfbbf24, 1.1);
      rim.position.set(3.5, 1.8, -2.5);
      scene.add(rim);

      const groundBounce = new THREE.DirectionalLight(0x22c55e, 0.8);
      groundBounce.position.set(0, -3, 0);
      scene.add(groundBounce);

      const controls = new OrbitControls(camera, controlsElement);
      controls.enableDamping = !reducedMotion;
      controls.enablePan = false;
      controls.enableZoom = false;
      controls.autoRotate = !reducedMotion;
      controls.autoRotateSpeed = 0.72;
      controls.target.set(0, -0.04, 0);
      controlsElement.style.touchAction = coarsePointer ? 'pan-y' : 'none';

      let isMouseDown = false;
      let modelReady = false;
      let modelBounds = new THREE.Box3();
      let fittedDistance = camera.position.distanceTo(controls.target);
      let minimumDistanceFactor = 0.62;
      let viewerVisible = true;
      let userInteracted = false;
      let storyProgress = 0;
      let scrollFrame = 0;
      let resumeRotationTimer = 0;
      let stageWidth = 1;
      let stageHeight = 1;
      let loopRunning = false;

      const draw = () => {
        renderer.render(scene, camera);
      };

      const renderFrame = () => {
        controls.update();
        draw();
      };

      const smoothstep = (start: number, end: number, value: number) => {
        const progress = THREE.MathUtils.clamp((value - start) / (end - start), 0, 1);
        return progress * progress * (3 - 2 * progress);
      };

      const fitCamera = () => {
        if (modelBounds.isEmpty()) return;

        const wideLayout = window.matchMedia('(min-width: 64rem)').matches;
        const largeLayout = window.matchMedia('(min-width: 80rem)').matches;
        const direction = camera.position.clone().sub(controls.target).normalize();
        const targetWidth = largeLayout ? 0.64 : wideLayout ? 0.56 : 0.92;
        const targetHeight = largeLayout ? 0.88 : wideLayout ? 0.78 : 0.76;
        const { min, max } = modelBounds;
        const corners = [
          new THREE.Vector3(min.x, min.y, min.z),
          new THREE.Vector3(min.x, min.y, max.z),
          new THREE.Vector3(min.x, max.y, min.z),
          new THREE.Vector3(min.x, max.y, max.z),
          new THREE.Vector3(max.x, min.y, min.z),
          new THREE.Vector3(max.x, min.y, max.z),
          new THREE.Vector3(max.x, max.y, min.z),
          new THREE.Vector3(max.x, max.y, max.z),
        ];

        camera.clearViewOffset();

        const fitsAtDistance = (distance: number) => {
          camera.position.copy(controls.target).addScaledVector(direction, distance);
          camera.lookAt(controls.target);
          camera.updateMatrixWorld();

          let minX = Number.POSITIVE_INFINITY;
          let maxX = Number.NEGATIVE_INFINITY;
          let minY = Number.POSITIVE_INFINITY;
          let maxY = Number.NEGATIVE_INFINITY;

          corners.forEach((corner) => {
            const projected = corner.clone().project(camera);
            minX = Math.min(minX, projected.x);
            maxX = Math.max(maxX, projected.x);
            minY = Math.min(minY, projected.y);
            maxY = Math.max(maxY, projected.y);
          });

          return maxX - minX <= targetWidth * 2 && maxY - minY <= targetHeight * 2;
        };

        let nearDistance = 0.2;
        let farDistance = 10;
        for (let iteration = 0; iteration < 28; iteration += 1) {
          const testDistance = (nearDistance + farDistance) / 2;
          if (fitsAtDistance(testDistance)) farDistance = testDistance;
          else nearDistance = testDistance;
        }

        fittedDistance = farDistance * 1.03;
        minimumDistanceFactor = wideLayout ? 0.52 : 0.62;
        camera.position.copy(controls.target).addScaledVector(direction, fittedDistance);
        camera.near = Math.max(fittedDistance / 100, 0.01);
        camera.far = fittedDistance * 20;
        controls.minDistance = fittedDistance * minimumDistanceFactor;
        controls.maxDistance = fittedDistance * 1.6;
        camera.updateProjectionMatrix();
        controls.update();
      };

      const applyStoryPose = () => {
        const wideLayout = window.matchMedia('(min-width: 64rem)').matches;
        const approach = wideLayout && !reducedMotion
          ? smoothstep(0.08, 0.92, storyProgress)
          : 0;
        const visualShift = wideLayout
          ? stageWidth * THREE.MathUtils.lerp(0.235, 0.215, approach)
          : 0;
        const captionOpacity = wideLayout
          ? 1 - smoothstep(0.42, 0.72, storyProgress)
          : 1;

        robotRig.rotation.set(0, 0, 0);
        robotRig.position.set(0, THREE.MathUtils.lerp(0, 0.05, approach), 0);
        robotRig.scale.setScalar(THREE.MathUtils.lerp(1, 1.09, approach));
        controls.autoRotate = !reducedMotion && !userInteracted;

        camera.setViewOffset(stageWidth, stageHeight, -visualShift, 0, stageWidth, stageHeight);
        camera.updateProjectionMatrix();

        viewer?.style.setProperty('--landing-visual-shift', `${visualShift.toFixed(2)}px`);
        viewer?.style.setProperty('--landing-viewer-caption-opacity', captionOpacity.toFixed(3));

        // Si el loop de animación ya está corriendo, él dibuja el frame: pintar acá
        // además duplica el render en cada scroll.
        if (modelReady && viewerVisible && !document.hidden && !loopRunning) draw();
      };

      const updateStoryProgress = () => {
        if (!story) return;

        const wideLayout = window.matchMedia('(min-width: 64rem)').matches;
        if (wideLayout) {
          const rect = story.getBoundingClientRect();
          const scrollableDistance = Math.max(rect.height - window.innerHeight, 1);
          storyProgress = THREE.MathUtils.clamp(-rect.top / scrollableDistance, 0, 1);
        } else {
          storyProgress = 0;
        }

        applyStoryPose();
      };

      const queueStoryUpdate = () => {
        if (scrollFrame) return;
        scrollFrame = window.requestAnimationFrame(() => {
          scrollFrame = 0;
          updateStoryProgress();
        });
      };

      updateStoryProgress();
      story?.classList.add('is-scroll-ready');
      window.addEventListener('scroll', queueStoryUpdate, { passive: true });
      window.addEventListener('resize', queueStoryUpdate);

      const syncRenderLoop = () => {
        const shouldLoop = modelReady && !reducedMotion && viewerVisible && !document.hidden;
        if (shouldLoop !== loopRunning) {
          loopRunning = shouldLoop;
          renderer.setAnimationLoop(shouldLoop ? renderFrame : null);
        }
        if (modelReady && viewerVisible && !shouldLoop && !document.hidden) draw();
      };

      const pauseAutoRotation = () => {
        userInteracted = true;
        window.clearTimeout(resumeRotationTimer);
        controls.autoRotate = false;
      };

      const resumeAutoRotationSoon = () => {
        if (reducedMotion) return;
        window.clearTimeout(resumeRotationTimer);
        resumeRotationTimer = window.setTimeout(() => {
          userInteracted = false;
          applyStoryPose();
        }, 1800);
      };

      controls.addEventListener('start', () => {
        pauseAutoRotation();
      });
      controls.addEventListener('end', () => {
        isMouseDown = false;
        resumeAutoRotationSoon();
      });
      if (reducedMotion) controls.addEventListener('change', draw);

      controlsElement.addEventListener('pointerdown', (event) => {
        pauseAutoRotation();
        if (!coarsePointer && event.button === 0) isMouseDown = true;
      });
      const releaseMouse = () => {
        isMouseDown = false;
        resumeAutoRotationSoon();
      };
      controlsElement.addEventListener('pointerup', releaseMouse, { capture: true });
      controlsElement.addEventListener('pointercancel', releaseMouse, { capture: true });
      controlsElement.addEventListener('lostpointercapture', releaseMouse);
      window.addEventListener('pointerup', releaseMouse);
      window.addEventListener('pointercancel', releaseMouse);

      controlsElement.addEventListener(
        'wheel',
        (event) => {
          if (coarsePointer || !isMouseDown) return;
          event.preventDefault();
          pauseAutoRotation();
          resumeAutoRotationSoon();
          const zoomFactor = Math.pow(0.95, -event.deltaY * 0.008);
          const offset = camera.position.clone().sub(controls.target);
          const newDistance = offset.length() * zoomFactor;
          if (
            newDistance >= fittedDistance * minimumDistanceFactor &&
            newDistance <= fittedDistance * 1.55
          ) {
            offset.multiplyScalar(zoomFactor);
            camera.position.copy(controls.target).add(offset);
            draw();
          }
        },
        { passive: false }
      );

      const resize = () => {
        stageWidth = Math.max(stage.clientWidth, 1);
        stageHeight = Math.max(stage.clientHeight, 1);
        renderer.setSize(stageWidth, stageHeight);
        camera.aspect = stageWidth / stageHeight;
        camera.clearViewOffset();
        fitCamera();
        applyStoryPose();
        if (modelReady && viewerVisible && !document.hidden) draw();
      };
      resize();
      new ResizeObserver(resize).observe(stage);

      const visibilityObserver = new IntersectionObserver(
        ([entry]) => {
          viewerVisible = entry?.isIntersecting ?? false;
          syncRenderLoop();
        },
        { rootMargin: '15% 0px' }
      );
      visibilityObserver.observe(stage);
      document.addEventListener('visibilitychange', syncRenderLoop);

      const manager = new THREE.LoadingManager();
      manager.onError = (url) => reportError(`no se pudo cargar ${url.split('/').pop()}`);

      const loader = new GLTFLoader(manager);
      loader.load(
        `${base}/models/rosmaster_unified.glb`,
        (gltf) => {
          const robot = gltf.scene;
          robot.rotation.set(0, 0, 0);

          const rgbdCamera = robot.getObjectByName('rgbd_camera');
          if (rgbdCamera) rgbdCamera.position.z = -10;

          const box = new THREE.Box3().setFromObject(robot);
          const size = box.getSize(new THREE.Vector3());
          const center = box.getCenter(new THREE.Vector3());
          const maxDimension = Math.max(size.x, size.y, size.z);
          const scale = 1.32 / maxDimension;
          robot.scale.setScalar(scale);
          robot.position.copy(center).multiplyScalar(-scale);
          robot.position.y -= 0.04;

          robotRig.add(robot);
          modelBounds = new THREE.Box3().setFromObject(robot);
          controls.target.copy(modelBounds.getCenter(new THREE.Vector3()));
          modelReady = true;
          fitCamera();
          applyStoryPose();
          status.classList.add('is-done');
          window.setTimeout(() => status.remove(), 350);
          syncRenderLoop();
        },
        (progress) => {
          if (!progress.loaded) return;
          const megabytes = (progress.loaded / 1048576).toFixed(0);
          status.textContent = `Cargando modelo 3D · ${megabytes} MB`;
        },
        (error) => reportError(error instanceof ErrorEvent ? error.message : 'error de carga')
      );
    }
  }
</script>
