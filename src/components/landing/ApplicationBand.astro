---
import { withBase } from '../../config/site';
---

<section class="landing-application" id="postulacion" aria-labelledby="application-title">
  <div class="landing-shell landing-application-inner">
    <div>
      <p class="landing-meta">Postulaciones cerradas</p>
      <h2 id="application-title">Nos vemos en Rosario.</h2>
      <p>
        Las postulaciones cerraron el 21 de octubre. Gracias a cada equipo que se anotó.
        El simulador, las guías y los workshops siguen abiertos: cualquiera puede usarlos
        para aprender ROS 2 y seguir el desafío hasta la JAR.
      </p>
    </div>

    <div class="landing-application-action">
      <ul aria-label="Estado del desafío">
        <li>Postulaciones cerradas el 21/10</li>
        <li>Participación gratuita</li>
        <li>Material abierto para todos</li>
      </ul>
      <a href={withBase('/reglamento/')}>
        Leer el reglamento
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
