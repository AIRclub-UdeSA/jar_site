---
import Base from '../layouts/Base.astro';
import { SITE, withBase } from '../config/site';
---

<Base>
  <section class="hero-fs">
    <div id="robot-stage" class="hero-fs-stage">
      <p class="stage-loading">inicializando robot…</p>
    </div>

    <div class="stage-corners" aria-hidden="true"></div>

    <div class="hero-fs-content">
      <div class="hero-fs-top anim-fade-up delay-1">
        <div class="sys-badge">
          <span class="pulse-dot"></span>
          <span>challenge jar · rosario · 03–06 nov 2026</span>
        </div>
        <h1 class="hero-fs-title anim-fade-up delay-2">
          Un robot.<br />
          Una tarea.<br />
          <span class="grad-text">Tu código.</span>
        </h1>
      </div>

      <div class="hero-fs-bottom">
        <div class="hero-fs-info anim-fade-up delay-3">
          <p class="hero-fs-sub">
            Armamos una flota de ROSMASTER X3 y un gemelo digital abierto en Gazebo.
            Vos y tu equipo desarrollan el comportamiento autónomo desde su compu —
            y lo ponen a prueba en la pista real de Rosario.
          </p>
          <div class="hero-fs-actions anim-fade-up delay-4">
            <a class="btn btn-primary btn-glow" href={withBase('/setup/')}>
              Preparar el entorno
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="btn-arrow"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
            <a class="btn btn-ghost" href="#postulacion">Postular equipo</a>
          </div>
        </div>

        <div class="hero-fs-meta anim-fade-up delay-4">
          <span class="stage-hint">
            <span class="pulse-dot"></span>arrastrá para orbitar · click + scroll para zoom
          </span>
          <a class="scroll-hint" href="#desafio" aria-label="Bajar a la siguiente sección">
            <span>scroll para explorar</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 01 // EL DESAFÍO -->
  <section class="sec" id="desafio">
    <div class="wrap">
      <div class="split-asym">
        <div class="split-main reveal">
          <p class="sys-label">[ 01 // el desafío ]</p>
          <h2 class="s-title">Comportamiento autónomo,<br />de verdad.</h2>
          <p class="s-desc" style="margin-bottom: 24px;">
            Sin control remoto ni intervención manual: el robot percibe, procesa y decide solo.
            Desarrollás tu software sobre el gemelo digital en Gazebo y lo ejecutamos en vivo en el hardware físico en Rosario.
          </p>
          <p class="s-desc" style="margin-bottom: 0;">
            El objetivo es poner a prueba algoritmos de navegación, percepción y toma de decisiones en un entorno real. Vos y tu equipo programan los nodos de ROS 2; nosotros ponemos los robots y la pista.
          </p>

          <div class="mission-callout reveal reveal-d1">
            <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 8px;">
              <span class="sys-label" style="margin-bottom: 0; color: var(--amber);">[ misión y reglamento ]</span>
              <span class="tag" style="color: var(--amber); background: rgba(251, 191, 36, 0.08); border-color: rgba(251, 191, 36, 0.2);">Próximamente</span>
            </div>
            <p>
              La consigna detallada, las métricas de puntaje y el reglamento oficial de pista se anunciarán próximamente. Mientras tanto, los workshops y la guía de setup te dan el entorno necesario para comenzar a practicar.
            </p>
          </div>
        </div>

        <div class="specs-terminal reveal reveal-d2">
          <div class="terminal-top">
            <span>// HARDWARE & GEMELO DIGITAL</span>
            <span class="pulse-dot"></span>
          </div>
          <div class="terminal-rows">
            <div class="terminal-row">
              <span class="t-label">Plataforma</span>
              <span class="t-val">Flota ROSMASTER X3</span>
            </div>
            <div class="terminal-row">
              <span class="t-label">Tracción</span>
              <span class="t-val">Mecanum 4WD (Omnidireccional)</span>
            </div>
            <div class="terminal-row">
              <span class="t-label">Sensores</span>
              <span class="t-val">LiDAR 2D 360° + RGB-D + IMU 9-DOF</span>
            </div>
            <div class="terminal-row">
              <span class="t-label">Simulación</span>
              <span class="t-val">Gazebo Fortress (Física real)</span>
            </div>
            <div class="terminal-row">
              <span class="t-label">Middleware</span>
              <span class="t-val" style="color: var(--accent);">ROS 2 Humble</span>
            </div>
          </div>
          <div class="specs-chips">
            <span class="spec-chip"><em>Topics</em> Idénticos a hardware</span>
            <span class="spec-chip"><em>Física</em> Contactos y fricción</span>
            <span class="spec-chip"><em>Open Source</em> Disponible en GitHub</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- 02 // LA JAR 2026 -->
  <section class="sec" id="jar">
    <div class="wrap">
      <div class="jar-monument reveal">
        <div>
          <p class="sys-label">[ 02 // la jar 2026 ]</p>
          <h2 class="jar-hero-heading">Rosario · 03 al 06 NOV 2026</h2>
        </div>

        <div class="jar-detail-split">
          <div class="jar-narrative">
            <p class="s-desc" style="margin-bottom: 20px; font-size: 1.05rem;">
              Las <strong>Jornadas Argentinas de Robótica (JAR)</strong> son el encuentro más importante del país en la disciplina, congregando a investigadores, laboratorios, docentes y estudiantes de toda la región.
            </p>
            <p class="s-desc" style="margin-bottom: 0;">
              En esta edición en la <strong>FCEIA - UNR</strong>, el <strong>AIR Club UdeSA</strong> organiza el Challenge JAR: un desafío abierto de comportamiento autónomo donde cada equipo evalúa su software en tiempo real frente a toda la comunidad.
            </p>
          </div>

          <div class="jar-links-cluster">
            <a class="jar-link-card" href="https://jar.net.ar/" target="_blank" rel="noopener">
              <div>
                <span style="display: block; font-family: var(--font-display); font-weight: 700; font-size: 1rem; color: var(--text); margin-bottom: 2px;">Sitio Oficial JAR 2026</span>
                <span style="font-size: 0.72rem; color: var(--text-3);">jar.net.ar — Programa y conferencias</span>
              </div>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
            </a>

            <a class="jar-link-card" href="https://web.fceia.unr.edu.ar/" target="_blank" rel="noopener">
              <div>
                <span style="display: block; font-family: var(--font-display); font-weight: 700; font-size: 1rem; color: var(--text); margin-bottom: 2px;">Sede FCEIA - UNR</span>
                <span style="font-size: 0.72rem; color: var(--text-3);">Facultad de Cs. Exactas, Ing. y Agrimensura (Rosario)</span>
              </div>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- 03 // HOJA DE RUTA -->
  <section class="sec" id="roadmap">
    <div class="wrap">
      <div class="reveal">
        <p class="sys-label">[ 03 // hoja de ruta ]</p>
        <h2 class="s-title">El camino a la pista</h2>
        <p class="s-desc">
          Cuatro etapas para pasar de cero a correr tu propio algoritmo en los ROSMASTER físicos.
        </p>
      </div>

      <div class="stepper-flow">
        <div class="stepper-item active reveal reveal-d1">
          <div class="stepper-top">
            <span class="stepper-num">01</span>
            <span class="tag">disponible</span>
          </div>
          <h3>Montá tu entorno</h3>
          <p>Instalá Ubuntu 22.04 + ROS 2 Humble + Gazebo Fortress con nuestra guía y levantá el simulador en tu compu.</p>
        </div>

        <div class="stepper-item active reveal reveal-d2">
          <div class="stepper-top">
            <span class="stepper-num">02</span>
            <span class="tag">en curso</span>
          </div>
          <h3>Workshops prácticos</h3>
          <p>Módulos de práctica asincrónica: desde nodos y cinemática mecanum hasta SLAM, mapeo y navegación autónoma.</p>
        </div>

        <div class="stepper-item reveal reveal-d3">
          <div class="stepper-top">
            <span class="stepper-num">03</span>
            <span class="tag" style="color: var(--amber); background: rgba(251, 191, 36, 0.08); border-color: rgba(251, 191, 36, 0.2);">pronto</span>
          </div>
          <h3>Consigna oficial</h3>
          <p>Lanzamiento del reglamento completo, objetivos específicos de la tarea y apertura de entregas de repositorios.</p>
        </div>

        <div class="stepper-item reveal">
          <div class="stepper-top">
            <span class="stepper-num">04</span>
            <span class="tag tag-muted">03–06 nov</span>
          </div>
          <h3>Despliegue en Rosario</h3>
          <p>Cargamos tu código en los robots reales y evaluamos el comportamiento de tu software en vivo en la JAR.</p>
        </div>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- 04 // POSTULACIÓN -->
  <section class="sec" id="postulacion">
    <div class="wrap">
      <div class="cta-monument reveal">
        <div class="cta-monument-inner">
          <div class="cta-monument-text">
            <p class="sys-label" style="margin-bottom: 8px;">[ 04 // convocatoria ]</p>
            <h2>Postulá a tu equipo al Challenge JAR</h2>
            <p>
              Completá el formulario para postular a tu equipo. Como la capacidad en pista es limitada, realizaremos un proceso de selección antes del evento en Rosario. La postulación es abierta, 100% gratuita y sin límite de integrantes.
            </p>
            <div class="cta-badges">
              <span class="cta-badge"><span class="pulse-dot"></span>postulaciones abiertas</span>
              <span class="cta-badge">cupos limitados</span>
              <span class="cta-badge">participación gratuita</span>
            </div>
          </div>
          <div class="cta-actions">
            <a class="btn btn-primary" href="https://forms.gle/2zkW6gwJQptUzbXn6" target="_blank" rel="noopener" style="padding: 14px 28px; font-size: 0.85rem;">
              Formulario de postulación
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- 05 // RECURSOS -->
  <section class="sec" id="recursos">
    <div class="wrap">
      <div class="reveal">
        <p class="sys-label">[ 05 // recursos ]</p>
        <h2 class="s-title">Empezá a construir hoy</h2>
        <p class="s-desc">Todo el material necesario para preparar tu stack y practicar con el gemelo digital.</p>
      </div>

      <div class="resource-list reveal">
        <a class="resource-row" href={withBase('/setup/')}>
          <div class="resource-name">Guía de Setup</div>
          <div class="resource-desc">Instalá ROS 2 Humble, Gazebo Fortress y RViz 2, y levantá el simulador del ROSMASTER paso a paso en tu máquina.</div>
          <div class="resource-arrow">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </div>
        </a>

        <a class="resource-row" href={withBase('/workshops/')}>
          <div class="resource-name">Workshops</div>
          <div class="resource-desc">Nodos, publishers/subscribers, movimiento omnidireccional y SLAM: código de ejemplo listo para clonar y ejecutar en el simulador.</div>
          <div class="resource-arrow">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </div>
        </a>

        <a class="resource-row" href={SITE.simRepo} target="_blank" rel="noopener">
          <div class="resource-name">Simulador en GitHub</div>
          <div class="resource-desc">El gemelo digital completo es open source. Explorá los paquetes de ROS 2, los modelos URDF y sumá aportes a la comunidad.</div>
          <div class="resource-arrow">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
          </div>
        </a>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- 06 // PREGUNTAS FRECUENTES -->
  <section class="sec" id="faq">
    <div class="wrap">
      <div class="reveal">
        <p class="sys-label">[ 06 // faq ]</p>
        <h2 class="s-title">Preguntas frecuentes</h2>
        <p class="s-desc">Todo lo que necesitás saber sobre la dinámica, los equipos y la competencia.</p>
      </div>

      <div class="faq-hairline">
        <details class="faq-hl-item reveal">
          <summary class="faq-hl-summary">
            <span>¿Hace falta tener un robot físico para participar?</span>
            <span class="faq-hl-icon">+</span>
          </summary>
          <div class="faq-hl-body">
            <p>
              No. El AIR Club UdeSA pone a disposición una flota completa de robots ROSMASTER X3 reales en Rosario. Durante todo el período de desarrollo trabajás exclusivamente sobre el gemelo digital en Gazebo Fortress, que replica los mismos topics, sensores y dinámica física que el hardware real.
            </p>
          </div>
        </details>

        <details class="faq-hl-item reveal">
          <summary class="faq-hl-summary">
            <span>¿Cuántas personas pueden integrar un equipo y cómo es la selección?</span>
            <span class="faq-hl-icon">+</span>
          </summary>
          <div class="faq-hl-body">
            <p>
              No hay límite en la cantidad de integrantes por equipo: podés participar individualmente o en grupos de cualquier tamaño (universitarios, terciarios, secundarios o entusiastas independientes).
            </p>
            <p>
              Dado que la flota física de robots y el tiempo de pista en Rosario son limitados, las postulaciones pasarán por un proceso de selección previo. Si tu equipo es seleccionado, es obligatorio que al menos un integrante (el capitán o un representante) asista presencialmente a la JAR para supervisar y ejecutar las pruebas en pista.
            </p>
          </div>
        </details>

        <details class="faq-hl-item reveal">
          <summary class="faq-hl-summary">
            <span>¿Tiene algún costo la postulación o participación?</span>
            <span class="faq-hl-icon">+</span>
          </summary>
          <div class="faq-hl-body">
            <p>
              No. La postulación y participación en el Challenge JAR son 100% gratuitas y abiertas. El simulador, las guías de instalación y el código de los workshops son material público y libre.
            </p>
          </div>
        </details>

        <details class="faq-hl-item reveal">
          <summary class="faq-hl-summary">
            <span>¿Qué nivel se necesita y qué herramientas se pueden usar?</span>
            <span class="faq-hl-icon">+</span>
          </summary>
          <div class="faq-hl-body">
            <p>
              No es necesario tener experiencia previa avanzada en robótica. Los workshops están pensados para darte el material base y nivelar conceptos clave de ROS 2 de forma progresiva.
            </p>
            <p>
              A la hora de resolver el desafío tenés total autonomía: investigación propia, uso de algoritmos existentes, paquetes de la comunidad de ROS 2 o librerías externas de visión y control están completamente permitidos.
            </p>
          </div>
        </details>

        <details class="faq-hl-item reveal">
          <summary class="faq-hl-summary">
            <span>¿Es obligatorio viajar a Rosario para competir?</span>
            <span class="faq-hl-icon">+</span>
          </summary>
          <div class="faq-hl-body">
            <p>
              Sí. Para los equipos que resulten seleccionados, es obligatorio que al menos un integrante (el capitán o un delegado) asista presencialmente a la JAR en Rosario (03 al 06 de noviembre de 2026) para presenciar las pruebas y calibrar la ejecución del software en el robot físico.
            </p>
          </div>
        </details>

        <details class="faq-hl-item reveal">
          <summary class="faq-hl-summary">
            <span>¿Cuándo se publican el reglamento y la tarea específica?</span>
            <span class="faq-hl-icon">+</span>
          </summary>
          <div class="faq-hl-body">
            <p>
              La consigna detallada, las métricas de evaluación y el reglamento oficial de pista se publicarán en este mismo sitio web con suficiente anticipación para que los equipos puedan implementar y ajustar sus soluciones en el simulador.
            </p>
          </div>
        </details>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- 07 // AIR CLUB UDESA -->
  <section class="sec" id="club">
    <div class="wrap">
      <div class="reveal">
        <p class="sys-label">[ 07 // el club ]</p>
        <h2 class="s-title">Somos el AIR Club UdeSA</h2>
      </div>

      <div class="manifesto-block reveal">
        <div class="manifesto-text">
          <p>
            Somos la comunidad de estudiantes de robótica e inteligencia artificial de la Universidad de San Andrés.
          </p>
          <p style="margin-top: 14px;">
            Creemos en aprender entre pares: compartimos lo que sabemos, nos potenciamos en equipo y encaramos proyectos que ninguno podría hacer solo — desde robots autónomos y simulación hasta IA aplicada al mundo real, con el acompañamiento del Departamento de Ingeniería de UdeSA.
          </p>
        </div>

        <div class="manifesto-links">
          <a class="manifesto-link-item" href={SITE.orgUrl} target="_blank" rel="noopener">
            <div>
              <span style="display: block; font-family: var(--font-display); font-weight: 700; font-size: 0.95rem; color: var(--text); margin-bottom: 2px;">Sitio Web Oficial</span>
              <span style="font-size: 0.72rem; color: var(--text-3);">clubroboticaudesa.netlify.app</span>
            </div>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
          </a>

          <a class="manifesto-link-item" href={SITE.githubOrg} target="_blank" rel="noopener">
            <div>
              <span style="display: block; font-family: var(--font-display); font-weight: 700; font-size: 0.95rem; color: var(--text); margin-bottom: 2px;">GitHub AIRclub-UdeSA</span>
              <span style="font-size: 0.72rem; color: var(--text-3);">Repositorios y proyectos abiertos</span>
            </div>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  const els = document.querySelectorAll('.reveal');
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          io.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12 }
  );
  els.forEach((el) => io.observe(el));

  document.querySelectorAll<HTMLElement>('.card, .roadmap-card, .jar-telemetry, .about-card').forEach((card) => {
    card.addEventListener('pointermove', (e) => {
      const rect = card.getBoundingClientRect();
      card.style.setProperty('--mx', `${e.clientX - rect.left}px`);
      card.style.setProperty('--my', `${e.clientY - rect.top}px`);
    });
  });
</script>

<script>
  import * as THREE from 'three';
  import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
  import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';

  const stage = document.getElementById('robot-stage');
  const hint = stage?.querySelector<HTMLElement>('.stage-loading') ?? null;

  function reportError(msg: string) {
    if (!hint) return;
    hint.classList.remove('done');
    hint.textContent = `error: ${msg}`;
  }

  if (stage && hint) {
    window.addEventListener('error', (e) => reportError(e.message));
    window.addEventListener('unhandledrejection', () => reportError('promesa rechazada'));

    const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let started = false;

    const lazyLoad = new IntersectionObserver(
      (entries) => {
        if (!started && entries.some((entry) => entry.isIntersecting)) {
          started = true;
          lazyLoad.disconnect();
          try {
            initViewer();
          } catch (err) {
            reportError(err instanceof Error ? err.message : String(err));
          }
        }
      },
      { rootMargin: '300px' }
    );
    lazyLoad.observe(stage);

    function initViewer() {
      if (!stage) return;

      const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.outputColorSpace = THREE.SRGBColorSpace;
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.25;
      stage.prepend(renderer.domElement);

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(34, 1, 0.05, 50);
      camera.position.set(1.75, 1.05, 2.25);

      // Iluminación para resaltar materiales metálicos y reflejos
      scene.add(new THREE.HemisphereLight(0xffffff, 0x14281c, 2.6));
      
      const key = new THREE.DirectionalLight(0xffffff, 3.4);
      key.position.set(2.5, 4.5, 3.5);
      scene.add(key);

      const fill = new THREE.DirectionalLight(0x4ade80, 1.8);
      fill.position.set(-3.5, 2.5, 2.5);
      scene.add(fill);

      const backLight = new THREE.DirectionalLight(0x86efac, 1.4);
      backLight.position.set(0, 3.5, -4);
      scene.add(backLight);

      const rim = new THREE.DirectionalLight(0xfbbf24, 1.1);
      rim.position.set(3.5, 1.8, -2.5);
      scene.add(rim);

      const groundBounce = new THREE.DirectionalLight(0x22c55e, 0.8);
      groundBounce.position.set(0, -3, 0);
      scene.add(groundBounce);

      const controls = new OrbitControls(camera, renderer.domElement);
      controls.enableDamping = true;
      controls.enablePan = false;
      // Desactivamos el zoom automático por rueda para permitir el scroll natural de la página
      controls.enableZoom = false;
      controls.autoRotate = !reducedMotion;
      controls.autoRotateSpeed = 1.2;
      controls.target.set(0, -0.04, 0);

      // Manejador para permitir zoom con rueda SOLO cuando el botón del mouse está presionado
      let isMouseDown = false;
      stage.addEventListener('pointerdown', (e) => {
        if (e.button === 0) isMouseDown = true;
      });
      window.addEventListener('pointerup', () => {
        isMouseDown = false;
      });
      window.addEventListener('pointercancel', () => {
        isMouseDown = false;
      });

      stage.addEventListener(
        'wheel',
        (e) => {
          if (isMouseDown) {
            e.preventDefault();
            const zoomFactor = Math.pow(0.95, -e.deltaY * 0.008);
            const offset = camera.position.clone().sub(controls.target);
            const dist = offset.length();
            const newDist = dist * zoomFactor;
            if (newDist >= 0.7 && newDist <= 5.5) {
              offset.multiplyScalar(zoomFactor);
              camera.position.copy(controls.target).add(offset);
              controls.update();
            }
          }
        },
        { passive: false }
      );

      const resize = () => {
        const w = stage.clientWidth;
        const h = stage.clientHeight;
        renderer.setSize(w, h);
        camera.aspect = Math.max(w, 1) / Math.max(h, 1);

        // En desktop desplazamos el punto de vista para que el robot se ubique en la mitad derecha
        if (w >= 1024) {
          camera.setViewOffset(w, h, -Math.round(w * 0.22), 0, w, h);
        } else {
          camera.clearViewOffset();
        }
        camera.updateProjectionMatrix();
      };
      resize();
      new ResizeObserver(resize).observe(stage);

      const manager = new THREE.LoadingManager();
      manager.onError = (url) => reportError(`no se pudo cargar ${url.split('/').pop()}`);

      const gltfLoader = new GLTFLoader(manager);
      gltfLoader.load(
        `${base}/models/rosmaster_unified.glb`,
        (gltf) => {
          const robot = gltf.scene;
          robot.rotation.set(0, 0, 0);

          // Ajuste de la cámara RGB-D: 1 cm (10 mm en unidades del CAD) hacia atrás en la referencia del robot
          const rgbdCam = robot.getObjectByName('rgbd_camera');
          if (rgbdCam) {
            rgbdCam.position.z = -10;
          }

          // Ajuste automático de escala con zoom aumentado y centrado
          const box = new THREE.Box3().setFromObject(robot);
          const size = box.getSize(new THREE.Vector3());
          const center = box.getCenter(new THREE.Vector3());
          const maxDim = Math.max(size.x, size.y, size.z);
          const scale = 1.28 / maxDim;
          robot.scale.setScalar(scale);
          robot.position.copy(center).multiplyScalar(-scale);
          robot.position.y -= 0.04;

          scene.add(robot);

          if (hint) {
            hint.classList.add('done');
            setTimeout(() => hint.remove(), 600);
          }

          renderer.setAnimationLoop(() => {
            controls.update();
            renderer.render(scene, camera);
          });
        },
        (progress) => {
          if (!hint || !progress || !progress.loaded) return;
          const mb = (progress.loaded / 1048576).toFixed(0);
          hint.textContent = `cargando robot · ${mb} MB`;
        },
        (err) =>
          reportError(err instanceof ErrorEvent ? err.message : 'no se pudo cargar el modelo 3D')
      );
    }
  }
</script>
