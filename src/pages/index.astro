---
import '../styles/landing.css';
import ApplicationBand from '../components/landing/ApplicationBand.astro';
import ChallengeOverview from '../components/landing/ChallengeOverview.astro';
import Closing from '../components/landing/Closing.astro';
import EventDetails from '../components/landing/EventDetails.astro';
import LandingHero from '../components/landing/LandingHero.astro';
import Resources from '../components/landing/Resources.astro';
import Roadmap from '../components/landing/Roadmap.astro';
import Base from '../layouts/Base.astro';
---

<Base bodyClass="landing-body">
  <main id="main-content" class="landing-page">
    <LandingHero />
    <ChallengeOverview />
    <Roadmap />
    <EventDetails />
    <Resources />
    <ApplicationBand />
    <Closing />
  </main>
</Base>
