---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import DocToc from '../components/docs/DocToc.astro';
import SetupPath from '../components/docs/SetupPath.astro';
import WorkshopCatalog from '../components/docs/WorkshopCatalog.astro';
import Sidebar from '../components/Sidebar.astro';
import { DOC_SECTIONS, withBase } from '../config/site';
import Base from './Base.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  entry: CollectionEntry<'docs'>;
  headings: Heading[];
}

const { entry, headings } = Astro.props;
const { title, description, status, duration, level, outcome } = entry.data;

const allDocs = await getCollection('docs');
const weeks = allDocs
  .filter((doc) => doc.id.startsWith('workshops/semana-'))
  .sort((a, b) => a.id.localeCompare(b.id));

const flat = [
  ...DOC_SECTIONS.flatMap((section) => section.items),
  { label: 'Sobre los workshops', href: '/workshops/' },
  ...weeks.map((week) => ({ label: week.data.title, href: `/${week.id}/` })),
];

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const normalized = flat.map((item) => ({
  ...item,
  url: withBase(item.href).replace(/\/+$/, '') || '/',
}));
const index = normalized.findIndex((item) => item.url === currentPath);
const prev = index > 0 ? normalized[index - 1] : undefined;
const next = index >= 0 && index < normalized.length - 1 ? normalized[index + 1] : undefined;
const currentLabel = normalized[index]?.label ?? title;
const isSetupIndex = entry.id === 'setup' || entry.id === 'setup/index';
const isWorkshopIndex = entry.id === 'workshops' || entry.id === 'workshops/index';
const isSetup = isSetupIndex || entry.id.startsWith('setup/');
const sectionLabel = isSetup ? 'Setup' : 'Workshops';
---

<Base title={title} description={description} bodyClass="docs-body">
  <div class="doc-shell">
    <aside class="doc-side" aria-label="Secciones de la documentación">
      <Sidebar />
    </aside>

    <main id="main-content" class="doc-main">
      <details class="doc-section-switcher" data-doc-switcher>
        <summary>
          <span>{sectionLabel}</span>
          <strong>{currentLabel}</strong>
          <span class="doc-switcher-arrow" aria-hidden="true">↓</span>
        </summary>
        <div class="doc-switcher-panel">
          <Sidebar />
        </div>
      </details>

      <article class="prose">
        <header class="doc-head">
          <div class="doc-head-topline">
            <p class="doc-kicker">{sectionLabel}</p>
            <div class="doc-head-facts">
              {
                duration && (
                  <span>Calculá {duration}</span>
                )
              }
              {
                level && (
                  <span>Nivel {level}</span>
                )
              }
              {status === 'proximamente' && <span class="doc-status upcoming">Próximamente</span>}
            </div>
          </div>
          <div class="doc-head-layout">
            <h1 class="doc-title">{title}</h1>
            <div class="doc-head-summary">
              {description && <p class="doc-desc">{description}</p>}
              {outcome && <p class="doc-outcome">{outcome}</p>}
            </div>
          </div>
        </header>

        {isSetupIndex && <SetupPath />}
        {isWorkshopIndex && <WorkshopCatalog />}
        {!isSetupIndex && !isWorkshopIndex && <DocToc headings={headings} />}
        <slot />
      </article>

      {
        (prev || next) && (
          <nav class="pager" aria-label="Páginas anterior y siguiente">
            {prev ? (
              <a href={prev.url} rel="prev">
                <span class="pager-label">Anterior</span>
                <span class="pager-title">{prev.label}</span>
              </a>
            ) : (
              <span />
            )}
            {next && (
              <a class="next" href={next.url} rel="next">
                <span class="pager-label">Siguiente</span>
                <span class="pager-title">{next.label}</span>
              </a>
            )}
          </nav>
        )
      }
    </main>
  </div>
</Base>

<script>
  const codeLabels: Record<string, string> = {
    bash: 'Terminal',
    sh: 'Terminal',
    shell: 'Terminal',
    python: 'Python',
    py: 'Python',
    text: 'Salida esperada',
    plaintext: 'Salida esperada',
  };

  document.querySelectorAll<HTMLElement>('.prose pre').forEach((pre) => {
    if (!pre.querySelector('code') || pre.closest('.doc-code')) return;

    const language = pre.getAttribute('data-language') ?? 'text';
    const label = codeLabels[language.toLowerCase()] ?? language.toUpperCase();
    const figure = document.createElement('figure');
    figure.className = 'doc-code';

    const caption = document.createElement('figcaption');
    caption.className = 'doc-code-caption';

    const title = document.createElement('span');
    title.className = 'doc-code-title';
    title.textContent = label;

    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'copy-btn';
    button.textContent = 'Copiar';
    button.setAttribute('aria-label', `Copiar bloque de ${label}`);
    button.setAttribute('aria-live', 'polite');
    button.addEventListener('click', async () => {
      const code = pre.querySelector('code')?.innerText ?? '';
      try {
        await navigator.clipboard.writeText(code);
        button.textContent = 'Copiado';
        button.classList.add('copied');
        window.setTimeout(() => {
          button.textContent = 'Copiar';
          button.classList.remove('copied');
        }, 1800);
      } catch {
        button.textContent = 'No se pudo copiar';
      }
    });

    caption.append(title, button);
    pre.replaceWith(figure);
    figure.append(caption, pre);
  });

  const switcher = document.querySelector<HTMLDetailsElement>('[data-doc-switcher]');
  if (switcher) {
    const closeSwitcher = () => switcher.removeAttribute('open');
    switcher.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeSwitcher));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && switcher.open) {
        closeSwitcher();
        switcher.querySelector<HTMLElement>('summary')?.focus();
      }
    });
    document.addEventListener('pointerdown', (event) => {
      if (switcher.open && event.target instanceof Node && !switcher.contains(event.target)) closeSwitcher();
    });
  }
</script>
