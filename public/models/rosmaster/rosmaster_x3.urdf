<robot name="rosmaster_x3" xmlns:ignition="http://ignitionrobotics.org/schema">
  <!-- Real X3: ~1.3 kg chassis+motors+PCBs + ~0.2 kg SBC/mount. Old value 4.6 kg was ~3× too heavy. -->
  <!-- base_footprint is the URDF root and therefore the model's canonical link.
       Gazebo Classic builds no physics body for a massless link, so queries like
       Model::WorldLinearVel() return NaN and gazebo_ros_planar_move can never
       move the robot. A token inertia gives it a body; the mass is four orders
       of magnitude below the chassis, so dynamics are unaffected. Fortress does
       not need this and leaves the link empty. -->
