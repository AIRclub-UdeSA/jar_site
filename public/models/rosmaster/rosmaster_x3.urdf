  <link name="cam_1_infra2_optical_frame"/>
  <!-- The Fortress rgbd_camera renders color and depth from one aperture and
         exposes only one optical frame ID.  Keep the color-named frames as
         compatibility aliases, co-located with the depth frames, unless this
         model is replaced by independently rendered color/depth sensors. -->
  <joint name="cam_1_color_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="cam_1_link"/>
    <child link="cam_1_color_frame"/>
  </joint>
