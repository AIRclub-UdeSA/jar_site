  <joint name="cam_1_color_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="cam_1_color_frame"/>
    <child link="cam_1_color_optical_frame"/>
  </joint>
  <link name="cam_1_color_optical_frame"/>
  <!-- Fortress RGB-D sensor: publishes <topic>/image, <topic>/depth_image,
         <topic>/camera_info, and <topic>/points through the Sensors system loaded
         by the world. Data is bridged to ROS by ros_gz_bridge and ros_gz_image.
         libgazebo_ros_camera.so is Classic-only and must NOT be used here. -->
  <gazebo reference="cam_1_link">
    <sensor name="cam_1" type="rgbd_camera">
      <camera>
        <!-- Gazebo renders cameras with +X forward, while ROS image data
               uses a +Z-forward optical frame.  Keep the sensor frame for
               the native XYZ point cloud and label image/calibration data
               with the optical frame through SDFormat's dedicated field. -->
        <optical_frame_id>cam_1_depth_optical_frame</optical_frame_id>
        <horizontal_fov>1.5184</horizontal_fov>
        <image>
          <width>424</width>
          <height>240</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>1.5</far>
        </clip>
        <lens>
          <type>gnomonical</type>
          <scale_to_hfov>true</scale_to_hfov>
          <intrinsics>
            <fx>223.40954070056824</fx>
            <fy>223.40954070056824</fy>
            <cx>212.0</cx>
            <cy>120.0</cy>
            <s>0.0</s>
          </intrinsics>
          <projection>
            <p_fx>223.40954070056824</p_fx>
            <p_fy>223.40954070056824</p_fy>
            <p_cx>212.0</p_cx>
            <p_cy>120.0</p_cy>
            <tx>0.0</tx>
            <ty>0.0</ty>
          </projection>
        </lens>
      </camera>
      <always_on>1</always_on>
      <update_rate>2</update_rate>
      <visualize>False</visualize>
      <topic>cam_1</topic>
      <gz_frame_id>cam_1_depth_frame</gz_frame_id>
    </sensor>
  </gazebo>
  <link name="laser_frame">
